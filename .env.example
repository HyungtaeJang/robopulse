# LM Studio 로컬 서버 설정
LMS_API_BASE=http://localhost:1234/v1
LMS_MODEL_NAME=gemma-4-26b  # LM Studio에 로드된 모델 이름으로 변경

# PostgreSQL 설정
DATABASE_URL=postgresql://postgres:password@localhost:5432/robopulse

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# 파이프라인 설정
NEWS_FETCH_INTERVAL_HOURS=1      # 뉴스 RSS 수집 주기 (시간)
VIDEO_FETCH_CRON_HOUR=3          # 유튜브 자막 수집 시각 (새벽 3시)
DEDUP_TTL_DAYS=90                # 중복 방지 URL 해시 보존 기간 (일)
MAX_ARTICLES_PER_SOURCE=20       # 소스당 최대 수집 기사 수
